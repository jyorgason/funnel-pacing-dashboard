# Copy this to .env and fill in your values.
# Never commit .env — it contains secrets.

# ── Databricks ────────────────────────────────────────────────────────────────
# Workspace settings → SQL Warehouses → your warehouse → Connection Details
DATABRICKS_HOST=your-workspace.azuredatabricks.net
DATABRICKS_TOKEN=dapi...
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id

# ── Google Sheets ─────────────────────────────────────────────────────────────
# GCP Console → IAM & Admin → Service Accounts → create key → download JSON
# Share the 2026 Marketing Targets sheet with the service account email (viewer)
GOOGLE_CREDS_JSON=credentials.json
